save-exact=true
# better-sqlite3 ships prebuilt Windows/Linux/macOS binaries (Node-API, works on
# Node 22+). Without this, npm tries to recompile it and fails on PCs without
# Visual Studio C++ tools. No dependency in package-lock.json needs install scripts;
# desktop/build-test.ps1 already installs with --ignore-scripts for the EXE.
ignore-scripts=true
