# Copy to .env.local (git-ignored) and fill in. No variable is required to run the app today.
# Never commit real values. Core POS must keep working without these (offline-first).

# --- Next.js ---
NEXT_TELEMETRY_DISABLED=1

# --- Supabase (planned: encrypted backup/restore, remote Admin access; NOT used by code yet) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
